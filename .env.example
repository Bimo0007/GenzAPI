# Get a free key at https://newsapi.org/register (100 requests/day on the free tier)
NEWS_API_KEY=

# Optional. Comma-separated list of allowed origins, e.g.:
# FRONTEND_ORIGIN=https://genztrader.com,http://localhost:5173
# Leave unset to allow any origin (fine for a public, read-only news endpoint).
FRONTEND_ORIGIN=

PORT=3001

# Get a free key at https://finnhub.io/register — powers the Economic
# Calendar tab (Forex Factory's own calendar blocks embedding and scraping,
# see README). Leave empty and /api/calendar returns "not configured".
FINNHUB_API_KEY=

# Free tier, no credit card required — get one at https://aistudio.google.com/apikey
# Powers the gold/silver direction analysis, the per-article breakdown, and
# the per-event AI Market Impact Analysis on the Economic Calendar.
# Leave empty and those features just return "not configured".
GEMINI_API_KEY=
