# Get a free key at https://newsapi.org/register (100 requests/day on the free tier)
NEWS_API_KEY=

# Optional. Comma-separated list of allowed origins, e.g.:
# FRONTEND_ORIGIN=https://genztrader.com,http://localhost:5173
# Leave unset to allow any origin (fine for a public, read-only news endpoint).
FRONTEND_ORIGIN=

PORT=3001

# Get a free key at https://finnhub.io/register — powers the Economic
# Calendar tab (Forex Factory's own calendar blocks embedding and scraping,
# see README). Leave empty and /api/calendar returns "not configured".
FINNHUB_API_KEY=

# Free tier, no credit card required — get one at https://aistudio.google.com/apikey
# Powers the gold/silver direction analysis, the per-article breakdown, and
# the per-event AI Market Impact Analysis on the Economic Calendar.
# Leave empty and those features just return "not configured".
GEMINI_API_KEY=

# --- Bakong KHQR payment (Pricing page, $9.99 / first 3 months) ---
#
# 1. Get a Bakong Open API token (one-time, manual):
#      POST {BAKONG_API_BASE_URL}/v1/request_token
#      body: {"email":"you@x.com","organization":"GenZ Trader","project":"genztrader-news-api"}
#      -> emails you a 20-character verification code.
#    Then:
#      POST {BAKONG_API_BASE_URL}/v1/verify   body: {"code":"<the emailed code>"}
#      -> returns {"data":{"token":"<JWT>"}} — that JWT is BAKONG_API_TOKEN below.
#      Renew later via POST /v1/renew_token, body {"email":"you@x.com"}.
#
# 2. Confirm the correct base URL for your environment against Bakong's own
#    developer docs (sandbox vs production) before setting this — don't
#    assume a guessed domain here.
BAKONG_API_BASE_URL=

BAKONG_API_TOKEN=

# Your Bakong merchant/individual account id, format like "yourname@aclb".
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=GenZ Trader
BAKONG_MERCHANT_CITY=Phnom Penh

# Firebase service account JSON, minified to ONE line — Firebase Console >
# Project Settings > Service Accounts > Generate new private key. Lets the
# backend mark a user "approved" in Firestore right after a confirmed
# Bakong payment (the client can't be trusted to grant itself access), and
# lets it actually change a user's password after a verified password-reset
# code (see EMAILJS_* below) — changing another account's password can only
# ever happen through this Admin SDK credential, never from the browser.
# Leave blank and the payment + password-reset endpoints report "not
# configured".
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- In-app "forgot password" (6-digit code, no email-link click) ---
# Same EmailJS account/service/template already used by the frontend for
# signup OTP codes (see genztrader-react's VITE_EMAILJS_* — same template,
# same {{email}}/{{passcode}}/{{time}} params) — copy those same values
# here (without the VITE_ prefix, since this runs server-side, not bundled
# into the frontend build).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Only needed if this EmailJS account has "strict mode" (API calls
# restricted to browser origins) turned on in the EmailJS dashboard —
# leave blank otherwise.
EMAILJS_PRIVATE_KEY=
# Signup OTP ({{passcode}}) template. Optional — falls back to
# EMAILJS_TEMPLATE_ID above. Set it if password-reset uses a different
# template than the signup code email.
EMAILJS_OTP_TEMPLATE_ID=

# --- AI trading (OANDA execution + Gemini analysis) ---
# Orders placed from the AI Trading page are REAL and go to this account.
# OANDA > Manage API Access to create a token; account id looks like 001-001-1234567-001.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
# "live" (api-fxtrade.oanda.com, default) or "practice" if the key belongs to a practice account.
OANDA_ENV=live
# Reuses GEMINI_API_KEY above. Optional override of the model used for trade analysis:
AI_TRADING_MODEL=gemini-2.5-flash
# Risk controls (defaults shown). Min risk-reward can't go below 2.
AI_RISK_PCT=1
AI_MAX_DAILY_LOSS_PCT=3
AI_MAX_OPEN_TRADES=3
AI_MIN_RR=2
AI_MIN_CONFIDENCE=70
# Needs FIREBASE_SERVICE_ACCOUNT_JSON (above) too: trades/limits are stored in Firestore.
# Only users with role admin/dev can place orders (shared broker account).

# --- Background AI signal scanner (runs 24/7 in this server, no browser needed) ---
# Needs OANDA_*, GEMINI_API_KEY and FIREBASE_SERVICE_ACCOUNT_JSON. Publishes signals only; never places orders.
AI_SCANNER_ENABLED=true
AI_SCAN_PAIRS=XAUUSD
AI_SCAN_INTERVAL_SEC=60
AI_SIGNAL_COOLDOWN_MIN=60
AI_MAX_SIGNALS_PER_DAY=6
AI_SCANNER_SIGNAL_TTL_MIN=15
# Optional Telegram delivery (create a bot with @BotFather, add it to your channel as admin):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Live chart candles (free alternative to OANDA) ---
# Get a key at twelvedata.com. Used for the AI chart when OANDA_* isn't set.
TWELVEDATA_API_KEY=
